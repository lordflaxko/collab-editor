# Copy this file to .env and fill in your keys.

# Enables the AI Assistant / Explain features.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Enables password reset emails.
# Get a free key at https://resend.com/api-keys -- no domain/DNS setup
# needed, sandbox sending works out of the box.
RESEND_API_KEY=

# Base URL the client is served from -- used to build the link inside
# password reset emails. Defaults to http://localhost:5173 if unset.
CLIENT_URL=

# --- Deployment ---

# Set to 1 only when the server sits behind a reverse proxy you control
# (nginx, Caddy, Cloudflare). Rate limiting then keys off X-Forwarded-For
# instead of the socket address, which would otherwise be the proxy's for
# every visitor. Leave unset when the server is exposed directly: the header
# is client-supplied, so trusting it without a proxy in front lets anyone
# forge a new identity per request and slip past the limits.
TRUST_PROXY=

# Set to 1 to let the Database panel connect to private, loopback, and
# link-local addresses. Off by default: it lets the server be used to reach
# things the caller can't, including cloud metadata endpoints. Turn it on
# for local development against a database on your own machine; leave it off
# on anything publicly reachable.
ALLOW_PRIVATE_DB_HOSTS=

# Set to 1 to switch request rate limiting off entirely. This exists for the
# end-to-end suite, which signs up an account per spec from a single
# address. Never set it on a public instance.
RATE_LIMIT_DISABLED=
